#!/usr/bin/env bash
# Install: git config core.hooksPath .githooks
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

if ! command -v cargo >/dev/null 2>&1; then
	echo "pre-push: cargo not found on PATH" >&2
	exit 1
fi

echo "pre-push: cargo test (lib, bins, examples)"
cargo test --workspace --locked --lib --bins --examples

echo "pre-push: cargo test (doc)"
cargo test --workspace --locked --doc
